# Dedicated PostgreSQL database for the Go engine. Apply migrations 0000-0003 first.
DATABASE_URL=postgres://hosting:change-me@localhost:5432/hosting?sslmode=disable
S3_ENDPOINT=localhost:9000
S3_BUCKET=hosting-artifacts
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
S3_USE_TLS=false
AUTH_HMAC_SECRET=replace-me-before-startup
LISTEN_ADDR=:8080
MAX_SOURCE_BYTES=20971520

# Redis Streams inspection queue (worker only; API writes to PostgreSQL outbox).
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
MAX_ARCHIVE_ENTRIES=10000
MAX_EXPANDED_BYTES=536870912
MAX_COMPRESSION_RATIO=200
INSPECTION_TIMEOUT_SECONDS=300
