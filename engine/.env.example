# Dedicated PostgreSQL database for the Go engine. Apply migrations 0000-0002 first.
DATABASE_URL=postgres://hosting:change-me@localhost:5432/hosting?sslmode=disable

# Private S3-compatible bucket. Provision it before starting the API.
S3_ENDPOINT=localhost:9000
S3_BUCKET=hosting-artifacts
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me
S3_REGION=us-east-1
S3_USE_TLS=false

# Must match the encrypted AUTH_HMAC_SECRET in the dashboard backend.
# Generate at least 32 random bytes; never commit the real value.
AUTH_HMAC_SECRET=replace-with-at-least-32-random-bytes

LISTEN_ADDR=:8080
MAX_SOURCE_BYTES=20971520
